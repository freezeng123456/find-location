# Server
PORT=8787
DATABASE_PATH=./data/places.db
# Set true when the app is served over HTTPS.
COOKIE_SECURE=false

# Optional API agent. Leave unset for the default Codex Skill workflow.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# NVIDIA NIM trial. The API key remains server-side and is never sent
# to the browser. Only comma-separated accounts in the allowlist can use it.
# NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_ALLOWED_ACCOUNTS=free
NVIDIA_TRIAL_RPM=8

# A shared trial account is created only when both values are configured.
# TRIAL_ACCOUNT_LOGIN=free
# TRIAL_ACCOUNT_PASSWORD=

# Reserved for a production AMap provider adapter.
# AMAP_WEB_SERVICE_KEY=
# VITE_AMAP_JS_KEY=
